# Docs-to-AI configuration overrides
#
# Copy this file to `.env` (same folder as pyproject.toml) and edit the values
# you want to change. Real environment variables always take precedence over
# this file, so Docker/CI/shell values are never overridden.
#
# Every setting below is optional. The value shown is the built-in default.

# --- Embedding model -------------------------------------------------------
EMBEDDING_MODEL=all-MiniLM-L6-v2
EMBEDDING_DIMENSION=384

# --- Chunking --------------------------------------------------------------
# Strategy: fixed_size | by_paragraph | semantic_heading | by_token | semantic
CHUNKING_STRATEGY=by_paragraph
CHUNK_SIZE=1000
CHUNK_OVERLAP=200
CHUNK_BY_TOKEN=False
TOKENIZER_MODEL=cl100k_base
PRESERVE_HEADINGS=True
MAX_HEADING_CHUNK_SIZE=2000
MIN_CHUNK_SIZE=50

# --- Semantic chunking (used when CHUNKING_STRATEGY=semantic) --------------
SEMANTIC_CHUNK_PERCENTILE=95
SEMANTIC_CHUNK_MIN_SIZE=200
SEMANTIC_CHUNK_MAX_SIZE=2000
SEMANTIC_CHUNK_BUFFER_SIZE=1

# --- Search ----------------------------------------------------------------
DEFAULT_SEARCH_RESULTS=10
MAX_SEARCH_RESULTS=20
USE_RERANKER=True
RERANKER_MODEL=cross-encoder/ms-marco-MiniLM-L-6-v2
RERANKER_TOP_N=50
USE_BM25=False
BM25_WEIGHT=0.3

# --- Topics ----------------------------------------------------------------
USE_FOLDER_AS_TOPIC=True
DEFAULT_TOPIC=uncategorized
TOPIC_SEPARATOR=" > "

# --- Storage ---------------------------------------------------------------
CHROMA_COLLECTION_NAME=my-documents
# DOCS_DIR=./my-docs

# --- Startup behaviour -----------------------------------------------------
FULL_SCAN_ON_BOOT=False
FOLDER_WATCHER_ACTIVE_ON_BOOT=True
DEBOUNCE_SECONDS=10
FULL_SCAN_INTERVAL_DAYS=7

# --- MCP server transport --------------------------------------------------
MCP_TRANSPORT=stdio
MCP_HOST=0.0.0.0
MCP_PORT=38777
