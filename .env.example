# Docs-to-AI configuration overrides
#
# Copy this file to `.env` (same folder as pyproject.toml) and edit the values
# you want to change. Real environment variables always take precedence over
# this file, so Docker/CI/shell values are never overridden.
#
# Every setting below is optional: the value shown IS the built-in default, and
# each line ends with a comment describing what it does, its options, and its
# default. Inline comments are stripped by app/config.py (and by Docker
# Compose), so keep the whitespace before `#` if you add your own.

# --- Embedding model -------------------------------------------------------
EMBEDDING_MODEL=Qwen/Qwen3-Embedding-0.6B   # what: sentence-transformers model that embeds chunks and queries (dense side of retrieval) | options: any Hugging Face embedding model, e.g. Qwen/Qwen3-Embedding-0.6B, BAAI/bge-m3, all-MiniLM-L6-v2 | default: Qwen/Qwen3-Embedding-0.6B
EMBEDDING_DIMENSION=1024   # what: vector size stored in the collection; must match the model, and changing it re-creates the index (re-scan needed) | options: integer matching the model, e.g. 384 (MiniLM), 768 (bge-base), 1024 (Qwen3-0.6B, bge-m3) | default: 1024
EMBEDDING_BATCH_SIZE=32   # what: how many texts are embedded per forward pass | options: 1-128 (lower uses less RAM, higher scans faster) | default: 32
# EMBEDDING_QUERY_PROMPT=Instruct: Given a web search query, retrieve relevant passages that answer the query   # what: instruction prefix added to search queries only (never to stored chunks) | options: any text, or leave this line commented out to use the model's built-in query prompt | default: (empty = the model's own "query" prompt, as shipped by Qwen3-Embedding)

# --- GPU acceleration ------------------------------------------------------
# Only the embedding model (indexing + queries) and the cross-encoder re-ranker
# can use a GPU; BM25 and the ChromaDB HNSW index always run on the CPU.
USE_GPU_ACCELERATION_IF_AVAILABLE=True   # what: put the embedding model and re-ranker on a CUDA/MPS device when one is detected, falling back to CPU automatically | options: True, False (False = always CPU, even on a GPU machine) | default: True
GPU_DEVICE_INDEX=0   # what: which CUDA GPU to use when several are visible (ignored on CPU/MPS) | options: 0 to (number of GPUs - 1); an out-of-range value warns and falls back to 0 | default: 0

# --- Chunking --------------------------------------------------------------
CHUNKING_STRATEGY=semantic   # what: how documents are split into chunks | options: semantic (split where sentence embeddings diverge), by_paragraph, semantic_heading (keeps headings), fixed_size, by_token | default: semantic
CHUNK_SIZE=1024   # what: target chunk size for the non-semantic strategies | options: integer; tokens when CHUNK_BY_TOKEN=True (512-1024 recommended), otherwise characters | default: 1024
CHUNK_OVERLAP=200   # what: how much adjacent chunks overlap in fixed_size/by_token chunking | options: 0 to CHUNK_SIZE-1, same unit as CHUNK_SIZE (0-100 recommended in token mode) | default: 200
CHUNK_BY_TOKEN=True   # what: measure all chunk sizes in tokens instead of characters | options: True, False | default: True
TOKENIZER_MODEL=cl100k_base   # what: tiktoken encoding used to count tokens | options: cl100k_base (GPT-4/3.5), o200k_base (GPT-4o), p50k_base (GPT-2) | default: cl100k_base
PRESERVE_HEADINGS=True   # what: split on markdown/HTML headings and keep the heading with each chunk | options: True, False | default: True
MAX_HEADING_CHUNK_SIZE=1024   # what: sections larger than this are split further (heading strategies) | options: integer, same unit as CHUNK_SIZE | default: 1024
MIN_CHUNK_SIZE=50   # what: fragments smaller than this are dropped | options: integer, same unit as CHUNK_SIZE | default: 50

# --- Semantic chunking (used when CHUNKING_STRATEGY=semantic) --------------
# These sizes are always token counts.
SEMANTIC_CHUNK_PERCENTILE=95   # what: percentile of sentence-to-sentence dissimilarity that becomes a chunk boundary | options: 0-100 (higher = fewer, bigger chunks; lower = more splits) | default: 95
SEMANTIC_CHUNK_MIN_SIZE=64   # what: chunks below this are merged into the previous chunk | options: integer tokens | default: 64
SEMANTIC_CHUNK_MAX_SIZE=1024   # what: hard cap; a chunk is flushed when it would exceed this | options: integer tokens (512-1024 recommended) | default: 1024
SEMANTIC_CHUNK_BUFFER_SIZE=1   # what: neighbouring sentences averaged when computing similarity, to smooth the signal | options: 0 (no smoothing), 1, 2 | default: 1

# --- Search ----------------------------------------------------------------
DEFAULT_SEARCH_RESULTS=10   # what: results returned when the client does not ask for a count | options: 1 to MAX_SEARCH_RESULTS | default: 10
MAX_SEARCH_RESULTS=20   # what: hard cap on results per search | options: integer >= DEFAULT_SEARCH_RESULTS | default: 20
USE_RERANKER=True   # what: re-score fused candidates with a cross-encoder before returning them | options: True, False | default: True
RERANKER_MODEL=cross-encoder/ms-marco-MiniLM-L-6-v2   # what: cross-encoder used for re-ranking | options: any Hugging Face cross-encoder, e.g. cross-encoder/ms-marco-MiniLM-L-6-v2, BAAI/bge-reranker-v2-m3 | default: cross-encoder/ms-marco-MiniLM-L-6-v2
RERANKER_TOP_N=50   # what: how many fused candidates are passed to the re-ranker | options: 10-200 (more = better recall, slower) | default: 50
USE_BM25=True   # what: add a BM25 keyword ranking next to the dense ranking and fuse both with RRF | options: True, False | default: True
BM25_WEIGHT=0.3   # what: reciprocal-rank-fusion weight of the BM25 list relative to dense | options: 0-1 (0 = dense only, 0.5 = equal weight, 1 = BM25 only) | default: 0.3
BM25_K1=1.5   # what: BM25 term-frequency saturation | options: 1.2-2.0 | default: 1.5
BM25_B=0.75   # what: BM25 document-length normalisation | options: 0 (off) to 1 (full) | default: 0.75
RRF_K=60   # what: Reciprocal Rank Fusion constant that damps lower-ranked hits | options: 1-100 (60 is the paper default) | default: 60

# --- Topics ----------------------------------------------------------------
USE_FOLDER_AS_TOPIC=True   # what: derive topic tags from each document's folder path | options: True, False | default: True
DEFAULT_TOPIC=uncategorized   # what: topic used when no folder topic applies | options: any label | default: uncategorized
TOPIC_SEPARATOR=" > "   # what: separator shown between hierarchical topics | options: any string; keep the quotes to preserve spaces | default: " > "

# --- Storage ---------------------------------------------------------------
CHROMA_COLLECTION_NAME=my-documents   # what: name of the ChromaDB collection holding the chunks | options: any name (a new name starts an empty index) | default: my-documents
CHROMA_SPACE=cosine   # what: HNSW distance space for the vector index | options: cosine (recommended for normalised embeddings), l2, ip | default: cosine
HNSW_EF_SEARCH=200   # what: query-time candidate list size; higher = better recall, slower | options: 10-500 (ChromaDB's own default is 100) | default: 200
HNSW_EF_CONSTRUCTION=200   # what: build-time candidate list size; only affects newly built index segments | options: 100-500 | default: 200
# DOCS_DIR=./my-docs   # what: folder scanned for documents when no other path is given | options: any directory path | default: ./my-docs

# --- Startup behaviour -----------------------------------------------------
FULL_SCAN_ON_BOOT=False   # what: re-index every document when the server starts | options: True, False | default: False
FOLDER_WATCHER_ACTIVE_ON_BOOT=True   # what: watch DOCS_DIR and index changes automatically | options: True, False | default: True
DEBOUNCE_SECONDS=10   # what: idle time after the last file change before it is processed | options: integer seconds | default: 10
FULL_SCAN_INTERVAL_DAYS=7   # what: days between automatic full rescans while the watcher runs | options: integer days | default: 7

# --- MCP server transport --------------------------------------------------
MCP_TRANSPORT=stdio   # what: how the MCP server communicates with its client | options: stdio (local process), websocket (HTTP/SSE endpoint) | default: stdio
MCP_HOST=0.0.0.0   # what: bind address in websocket mode | options: 0.0.0.0 (all interfaces), 127.0.0.1 (local only) | default: 0.0.0.0
MCP_PORT=38777   # what: TCP port in websocket mode | options: 1-65535 | default: 38777
